;;; kprokopenko-arc-magit-test.el --- Tests for Arc status integration -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'kprokopenko-arc-magit)

(ert-deftest kprokopenko-arc-parses-status-layers ()
  (let ((groups (kprokopenko-arc--status-entries
                 " M path with spaces.txt\nM  staged.txt\nMM both.txt\n?? new.txt\n")))
    (should (equal (mapcar #'cdr (alist-get 'staged groups))
                   '("staged.txt" "both.txt")))
    (should (equal (mapcar #'cdr (alist-get 'unstaged groups))
                   '("path with spaces.txt" "both.txt")))
    (should (equal (mapcar #'cdr (alist-get 'untracked groups))
                   '("new.txt")))))

(ert-deftest kprokopenko-arc-status-renders-sections-and-diff ()
  (with-temp-buffer
    (kprokopenko-arc-status-mode)
    (setq-local kprokopenko-arc-root "/tmp/")
    (cl-letf (((symbol-function 'kprokopenko-arc--run)
               (lambda (&rest args)
                 (pcase (car args)
                   ("info" "{\"branch\":\"work\",\"hash\":\"abcdef\"}")
                   ("status" " M file.txt\n")
                   ("diff" "--- file.txt\n+++ file.txt\n@@ -1 +1 @@\n-old\n+new\n")))))
      (kprokopenko-arc-refresh)
      (should (string-match-p "Unstaged changes (1)" (buffer-string)))
      (search-forward "file.txt" nil t)
      (beginning-of-line)
      (should (equal (oref (magit-current-section) value)
                     '(unstaged . "file.txt")))
      (magit-section-show (magit-current-section))
      (should (string-match-p "+new" (buffer-string))))))

(ert-deftest kprokopenko-arc-stage-uses-arc-add-for-selected-file ()
  (with-temp-buffer
    (kprokopenko-arc-status-mode)
    (setq-local kprokopenko-arc-root "/tmp/")
    (let (calls)
      (cl-letf (((symbol-function 'kprokopenko-arc--run)
                 (lambda (&rest args)
                   (push args calls)
                   (pcase (car args)
                     ("info" "{\"branch\":\"work\",\"hash\":\"abcdef\"}")
                     ("status" " M file.txt\n")
                     (_ "")))))
        (kprokopenko-arc-refresh)
        (goto-char (point-min))
        (search-forward "file.txt")
        (kprokopenko-arc-stage)
        (should (member '("add" "--" "file.txt") calls))))))

(ert-deftest kprokopenko-arc-does-not-stage-a-whole-file-from-a-diff-line ()
  (with-temp-buffer
    (kprokopenko-arc-status-mode)
    (setq-local kprokopenko-arc-root "/tmp/")
    (let (calls)
      (cl-letf (((symbol-function 'kprokopenko-arc--run)
                 (lambda (&rest args)
                   (push args calls)
                   (pcase (car args)
                     ("info" "{\"branch\":\"work\",\"hash\":\"abcdef\"}")
                     ("status" " M file.txt\n")
                     ("diff" "--- file.txt\n+++ file.txt\n@@ -1 +1 @@\n-old\n+new\n")))))
        (kprokopenko-arc-refresh)
        (search-forward "file.txt")
        (magit-section-show (magit-current-section))
        (search-forward "+new")
        (should-error (kprokopenko-arc-stage) :type 'user-error)
        (should-not (member '("add" "--" "file.txt") calls))))))

(ert-deftest kprokopenko-arc-push-preserves-prefixed-branch-name ()
  (with-temp-buffer
    (kprokopenko-arc-status-mode)
    (setq-local kprokopenko-arc-root "/tmp/")
    (let (calls)
      (cl-letf (((symbol-function 'kprokopenko-arc--run)
                 (lambda (&rest args)
                   (push args calls)
                   (if (equal args '("info" "--json"))
                       "{\"branch\":\"users/kprokopenko/work\",\"hash\":\"abcdef\"}"
                     "")))
                ((symbol-function 'kprokopenko-arc-refresh) #'ignore))
        (kprokopenko-arc-push)
        (should (member '("push" "-u" "users/kprokopenko/work") calls))))))

(provide 'kprokopenko-arc-magit-test)
